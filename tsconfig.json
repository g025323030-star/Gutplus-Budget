{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["es2021"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true, // זה השורה הקריטית!
    "emitDecoratorMetadata": true,   // וגם זו!
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}