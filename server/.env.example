NODE_ENV=development
PORT=3000

# Single Postgres connection string (used in production and optionally in development)
DATABASE_URL=postgres://user:password@host:5432/dbname

JWT_SECRET=your-jwt-secret-here
BCRYPT_ROUNDS=10

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.railway.app

# Base URL of the frontend, used in password reset email links
FRONTEND_URL=http://localhost:5173

# Nodemailer / SMTP settings
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_ADDRESS=no-reply@example.com
EMAIL_PASS=your-email-password
EMAIL_FROM_NAME=Gutplus Budget
